<Window x:Class="IndustrialVisionStudent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工业零件视觉检测上位机"
        Width="1280" Height="800" MinWidth="1050" MinHeight="680"
        Background="#F1F5F9">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,14,14,6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <Button Content="选择图片" Command="{Binding LoadImageCommand}"/>
                    <Button Content="加载示例图" Command="{Binding LoadSampleCommand}"/>
                    <Button Content="打开摄像头" Command="{Binding StartCameraCommand}"/>
                    <Button Content="停止摄像头" Command="{Binding StopCameraCommand}"/>
                    <Button Content="执行检测" Command="{Binding InspectCommand}"/>
                    <Button Content="保存配方" Command="{Binding SaveRecipeCommand}"/>
                    <Button Content="加载配方" Command="{Binding LoadRecipeCommand}"/>
                    <Button Content="系统自检" Command="{Binding RunDiagnosticsCommand}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="显示：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding DebugViews}"
                              SelectedItem="{Binding SelectedDebugView}" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111827" CornerRadius="8" Margin="0,0,12,0">
                <Grid Margin="12">
                    <Image x:Name="CameraImage" Source="{Binding DisplayImage}" Stretch="Uniform"/>
                    <Canvas x:Name="RoiCanvas" Background="Transparent"
                            MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                            MouseMove="RoiCanvas_MouseMove"
                            MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp"/>
                    <TextBlock Text="请选择一张白色背景、深色目标的图片"
                               Foreground="#94A3B8" FontSize="18"
                               Visibility="{Binding EmptyHintVisibility}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TabControl Grid.Column="1">
              <TabItem Header="检测参数">
               <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            IsEnabled="{Binding IsConfigurationEditable}">
                        <StackPanel>
                            <TextBlock Text="检测参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="生产批次"/>
                            <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="产品型号"/>
                            <TextBox Text="{Binding ProductModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="操作员"/>
                            <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="配方名称 / 版本"/>
                            <UniformGrid Columns="2" Margin="0,4,0,10">
                              <TextBox Text="{Binding RecipeName}" Margin="0,0,4,0" ToolTip="配方名称"/>
                              <TextBox Text="{Binding RecipeVersion}" ToolTip="配方版本"/>
                            </UniformGrid>
                            <TextBlock Text="摄像头来源"/>
                            <ComboBox ItemsSource="{Binding CameraSources}" SelectedItem="{Binding SelectedCameraSource}"
                                      Margin="0,4,0,8"/>
                            <TextBlock Text="USB设备编号（模拟摄像头忽略）"/>
                            <TextBox Text="{Binding CameraIndexText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <CheckBox Content="启用ROI（在左侧图像拖动鼠标框选）"
                                      IsChecked="{Binding IsRoiEnabled}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <TextBox Text="{Binding RoiXText}" ToolTip="ROI X" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding RoiYText}" ToolTip="ROI Y" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding RoiWidthText}" ToolTip="ROI宽度" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding RoiHeightText}" ToolTip="ROI高度"/>
                            </UniformGrid>
                            <TextBlock Text="二值化阈值（0～255）"/>
                            <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <CheckBox Content="目标比背景暗（取消后检测亮目标）"
                                      IsChecked="{Binding IsDarkObject}" Margin="0,0,0,8"/>
                            <CheckBox Content="使用自适应阈值（光照不均时使用）"
                                      IsChecked="{Binding UseAdaptiveThreshold}" Margin="0,0,0,8"/>
                            <TextBlock Text="自适应窗口 / 常数"/>
                            <UniformGrid Columns="2" Margin="0,4,0,10">
                              <TextBox Text="{Binding AdaptiveBlockSizeText}" Margin="0,0,4,0"
                                       ToolTip="大于或等于3的奇数"/>
                              <TextBox Text="{Binding AdaptiveConstantText}" ToolTip="通常使用2～10"/>
                            </UniformGrid>
                            <TextBlock Text="像素当量（mm/px，0表示未标定）"/>
                            <TextBox Text="{Binding PixelSizeMmText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10"
                                     ToolTip="必须由标定获得；未标定时保持0，不可凭空填写"/>
                            <TextBlock Text="最小轮廓面积"/>
                            <TextBox Text="{Binding MinimumContourAreaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="最小圆度（0～1）"/>
                            <TextBox Text="{Binding MinimumCircularityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="期望目标数量"/>
                            <TextBox Text="{Binding ExpectedCountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="合格面积下限"/>
                            <TextBox Text="{Binding MinimumOkAreaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="合格面积上限"/>
                            <TextBox Text="{Binding MaximumOkAreaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                            <TextBlock Text="宽度范围（px）"/>
                            <UniformGrid Columns="2" Margin="0,4,0,10">
                              <TextBox Text="{Binding MinimumWidthText}" Margin="0,0,4,0" ToolTip="最小宽度"/>
                              <TextBox Text="{Binding MaximumWidthText}" ToolTip="最大宽度"/>
                            </UniformGrid>
                            <TextBlock Text="高度范围（px）"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                              <TextBox Text="{Binding MinimumHeightText}" Margin="0,0,4,0" ToolTip="最小高度"/>
                              <TextBox Text="{Binding MaximumHeightText}" ToolTip="最大高度"/>
                            </UniformGrid>
                            <TextBlock Text="长宽比范围（宽÷高）" Margin="0,10,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                              <TextBox Text="{Binding MinimumAspectRatioText}" Margin="0,0,4,0" ToolTip="最小长宽比"/>
                              <TextBox Text="{Binding MaximumAspectRatioText}" ToolTip="最大长宽比"/>
                            </UniformGrid>
                            <TextBlock Text="期望中心X / Y（-1表示禁用）" Margin="0,10,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                              <TextBox Text="{Binding ExpectedCenterXText}" Margin="0,0,4,0" ToolTip="期望中心X"/>
                              <TextBox Text="{Binding ExpectedCenterYText}" ToolTip="期望中心Y"/>
                            </UniformGrid>
                            <TextBlock Text="中心允许偏移（px）" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding CenterToleranceText}" Margin="0,4,0,0"
                                     ToolTip="期望中心X/Y均不是-1时生效"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="检测结果" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ResultText}" FontSize="28" FontWeight="Bold"
                                       Foreground="{Binding ResultBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding JudgementReason}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding MeasurementSummary}" TextWrapping="Wrap" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
               </ScrollViewer>
              </TabItem>
              <TabItem Header="检测历史">
                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <ComboBox Width="85" ItemsSource="{Binding HistoryResultFilters}"
                              SelectedItem="{Binding HistoryResultFilter}" Margin="0,0,6,0"/>
                    <TextBox Width="90" Text="{Binding HistoryBatchFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="批次号；留空表示全部" Margin="0,0,6,0"/>
                    <TextBox Width="100" Text="{Binding HistoryProductFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="产品型号；留空表示全部" Margin="0,0,6,0"/>
                    <Button Content="刷新" Command="{Binding RefreshHistoryCommand}"/>
                    <Button Content="导出CSV" Command="{Binding ExportHistoryCommand}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,8">
                    <WrapPanel>
                      <DatePicker Width="115" SelectedDate="{Binding HistoryStartDate}" ToolTip="开始日期" Margin="0,0,6,0"/>
                      <DatePicker Width="115" SelectedDate="{Binding HistoryEndDate}" ToolTip="结束日期"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding HistorySummary}" Margin="0,6,0,4" TextWrapping="Wrap"/>
                    <Button Content="打开所选NG图片" Command="{Binding OpenNgImageCommand}"/>
                    <Button Content="清理孤立NG图片" Command="{Binding CleanupNgImagesCommand}"
                            ToolTip="仅删除超过7天且数据库没有引用的PNG证据图"/>
                  </StackPanel>
                  <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryRecords}" AutoGenerateColumns="False"
                            SelectedItem="{Binding SelectedHistoryRecord}"
                            IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="时间" Binding="{Binding InspectedAt, StringFormat=MM-dd HH:mm:ss}" Width="120"/>
                      <DataGridTextColumn Header="批次" Binding="{Binding BatchNumber}" Width="90"/>
                      <DataGridTextColumn Header="产品" Binding="{Binding ProductModel}" Width="100"/>
                      <DataGridTextColumn Header="操作员" Binding="{Binding OperatorName}" Width="90"/>
                      <DataGridTextColumn Header="配方" Binding="{Binding RecipeName}" Width="100"/>
                      <DataGridTextColumn Header="版本" Binding="{Binding RecipeVersion}" Width="60"/>
                      <DataGridTextColumn Header="PLC周期" Binding="{Binding PlcCycleId}" Width="85"/>
                      <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="50"/>
                      <DataGridTextColumn Header="代码" Binding="{Binding JudgementCode}" Width="90"/>
                      <DataGridTextColumn Header="面积px²" Binding="{Binding MaximumArea, StringFormat=F0}" Width="75"/>
                      <DataGridTextColumn Header="宽mm" Binding="{Binding WidthMm, StringFormat=F3}" Width="70"/>
                      <DataGridTextColumn Header="高mm" Binding="{Binding HeightMm, StringFormat=F3}" Width="70"/>
                      <DataGridTextColumn Header="面积mm²" Binding="{Binding AreaMm2, StringFormat=F3}" Width="80"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </TabItem>
              <TabItem Header="PLC通信">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="10">
                    <TextBlock Text="PLC模拟与自动检测" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="本机端口"/>
                    <TextBox Text="{Binding PlcPortText}" Margin="0,4,0,10"/>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Content="启动模拟器" Command="{Binding StartPlcServerCommand}"/>
                      <Button Content="停止模拟器" Command="{Binding StopPlcServerCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Content="连接" Command="{Binding ConnectPlcCommand}"/>
                      <Button Content="断开" Command="{Binding DisconnectPlcCommand}"/>
                      <Button Content="PING" Command="{Binding PingPlcCommand}"/>
                    </WrapPanel>
                    <CheckBox Content="自动模式（允许PLC触发检测）" IsChecked="{Binding IsAutomaticMode}" Margin="0,4,0,10"/>
                    <Button Content="模拟PLC发送START" Command="{Binding TriggerPlcCommand}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding PlcStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding PlcLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Height="300" TextWrapping="Wrap"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#475569"/>
        </Border>
    </Grid>
</Window>
